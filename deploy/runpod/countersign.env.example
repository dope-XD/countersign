# Copied to /workspace/countersign.env by setup.sh. Fill in every empty value; never commit the filled copy.

# Staff PIN for /agent, /fraud, /demo, /metrics. Long: the engine is on the public internet.
COUNTERSIGN_STAFF_PIN=
# 32-byte hex AES key for RED evidence clips:  python -c "import secrets; print(secrets.token_hex(32))"
COUNTERSIGN_EVIDENCE_KEY=

# The tunnel hostname. Passkeys are bound to it, so keep the one the demo phones already use.
NGROK_DOMAIN=countersign-demo.ngrok-free.app
NGROK_AUTHTOKEN=
COUNTERSIGN_RP_ID=countersign-demo.ngrok-free.app
COUNTERSIGN_ORIGINS=https://countersign-demo.ngrok-free.app
COUNTERSIGN_PUBLIC_URL=https://countersign-demo.ngrok-free.app

COUNTERSIGN_MAX_CALLS=4
COUNTERSIGN_EVAL=0
