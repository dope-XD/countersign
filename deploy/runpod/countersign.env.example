# Copied to /workspace/countersign.env by setup.sh. Fill in every empty value; never commit the filled copy.

# Staff PIN for /agent, /fraud, /demo, /metrics. Long: the engine is on the public internet.
COUNTERSIGN_STAFF_PIN=
# 32-byte hex AES key for RED evidence clips:  python -c "import secrets; print(secrets.token_hex(32))"
COUNTERSIGN_EVIDENCE_KEY=

# The tunnel hostname. Passkeys are bound to it, so keep the one the demo phones already use.
NGROK_DOMAIN=countersign-demo.ngrok-free.app
NGROK_AUTHTOKEN=
COUNTERSIGN_RP_ID=countersign-demo.ngrok-free.app
COUNTERSIGN_ORIGINS=https://countersign-demo.ngrok-free.app
COUNTERSIGN_PUBLIC_URL=https://countersign-demo.ngrok-free.app

# Judges call from /try at the same time; one 24 GB GPU holds about 32 calls (models/eval/load_*.json).
COUNTERSIGN_MAX_CALLS=8

# The CS Bank app's demo signing key (android/README.md): lets Chrome show the bank pages full screen in the app.
COUNTERSIGN_ANDROID_CERT_SHA256=49:4D:97:51:C6:18:8B:3B:C5:2E:61:41:6C:36:1D:71:DC:9E:BD:C7:99:5F:0D:96:20:F7:20:A6:E4:01:8B:2C

# Amazon Connect (optional): the Lambda's CONNECT_HMAC_SECRET, plus the read-only KVS user from
# integrations/connect/README.md step 7. Leave the secret empty to keep the endpoint off.
COUNTERSIGN_CONNECT_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
COUNTERSIGN_EVAL=0
