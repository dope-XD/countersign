<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A SIM makes the caller check work; internet calls are watched without one. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!-- Call state (idle / ringing / in a call). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- The number this phone dials, matched against the family list on the phone; it never leaves it. -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- A family check set to "Ring" shows full screen, like an incoming call. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The call check card over the dialer, and the pay guard over payment apps. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Which app is in front, only while a scam call is on: is it a payment app? -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Calling the bank from inside the app. -->
    <!-- The call listener: the mic during a call, in memory only (ListenService). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Texting family from this SIM when their app is offline during a scam call. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:name=".CsApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_bank"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The family invite QR code: csbank://family?code=123456 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="csbank" android:host="family" />
            </intent-filter>
        </activity>

        <!-- A family check or bank approval, full screen and over the lock screen. -->
        <activity
            android:name=".ApprovalActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity="app.countersign.bank.approval" />

        <service
            android:name=".CallWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Tells the bank when the customer is on a phone or internet call, so payments made under a caller's pressure can be paused, and rings for family checks and the bank's approval requests." />
        </service>

        <!-- Read the number of a call to match it against the family list; every call goes through untouched. -->
        <service
            android:name=".CallScreener"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".CallCheckNotice$Actions"
            android:exported="false" />

        <!-- The call listener: hears the call (the mic, on speaker), sees which app is in front, shows the card. -->
        <service
            android:name=".ListenService"
            android:exported="false"
            android:label="@string/listen_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/listen_service" />
        </service>

        <!-- The number this phone dials, read only: it never changes or cancels the call. -->
        <receiver
            android:name=".OutgoingCalls"
            android:exported="true"
            android:permission="android.permission.PROCESS_OUTGOING_CALLS">
            <intent-filter>
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
