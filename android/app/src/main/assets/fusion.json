{
  "version": 1,
  "about": "How the call listener turns evidence into a level (docs/agents/CONTRACT.md, 'Call listener'). Same logic in data/listen/Fusion.kt and engine/listener/fusion.py. Levels never go down during a call. 'strong' = a category that isn't weak; 'discussion' never counts as a category.",
  "watch": {
    "min_categories": 1
  },
  "warn": {
    "min_strong": 2,
    "llm_p": 0.6,
    "llm_min_categories": 1,
    "context_alone": [
      "caller_check_failed",
      "remote_app_opened"
    ]
  },
  "scam": {
    "cues_min_categories": 4,
    "cues_need_action": true,
    "cues_need_type": true,
    "discussion_blocks_cues": true,
    "llm_p": 0.8,
    "llm_min_categories": 2,
    "strong_context": [
      "remote_app_opened",
      "caller_check_failed",
      "video_call_unknown",
      "international_number"
    ]
  },
  "context_as_category": [
    "long_call",
    "international_number",
    "video_call_unknown"
  ],
  "trusted_context": [
    "caller_verified",
    "known_contact"
  ],
  "trusted_extra": 1,
  "server_fresh_s": 15
}
